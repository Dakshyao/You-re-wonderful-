rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: history
    // Fields:
    //   - uid: string (required) - Owner's UID
    //   - image: string (required, max 1MB) - Base64 image
    //   - prompt: string (required, max 5000) - Generation prompt
    //   - timestamp: timestamp (required) - Creation time
    //   - params: map (required) - Generation parameters
    //
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "dakshdramaticsurya@gmail.com" && request.auth.token.email_verified == true)); // Default admin
    }

    function isOwner(uid) {
      return isAuthenticated() && (request.auth.uid == uid || isAdmin());
    }

    function isValidHistoryItem(data) {
      return data.uid is string &&
             data.image is string && data.image.size() < 1048576 &&
             data.prompt is string && data.prompt.size() < 5000 &&
             data.timestamp is timestamp &&
             data.params is map;
    }

    match /history/{itemId} {
      allow read: if isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid) && isValidHistoryItem(request.resource.data);
      allow delete: if isOwner(resource.data.uid);
    }
    
    match /test/connection {
      allow read: if true;
    }
  }
}
