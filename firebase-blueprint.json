{
  "entities": {
    "HistoryItem": {
      "title": "HistoryItem",
      "description": "A generated image with its prompt and parameters",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user ID of the owner" },
        "image": { "type": "string", "description": "Base64 encoded image data" },
        "prompt": { "type": "string", "description": "The prompt used to generate the image" },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the image was generated" },
        "params": {
          "type": "object",
          "properties": {
            "aspectRatio": { "type": "string" },
            "lighting": { "type": "string" },
            "cameraAngle": { "type": "string" },
            "composition": { "type": "string" },
            "colorMood": { "type": "string" }
          }
        }
      },
      "required": ["uid", "image", "prompt", "timestamp", "params"]
    }
  },
  "firestore": {
    "/history": {
      "schema": "HistoryItem",
      "description": "Collection of user-generated image history"
    }
  }
}
